{
    "expo": {
        "name": "TryCast",
        "slug": "trycast",
        "version": "1.2.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "trycast",
        "userInterfaceStyle": "automatic",
        "runtimeVersion": {
            "policy": "fingerprint"
        },
        "updates": {
            "url": "https://u.expo.dev/7dfc088c-9942-4873-97ba-4c2a048d3170"
        },
        "ios": {
            "bundleIdentifier": "com.cohozen.trycast",
            "supportsTablet": false,
            "usesAppleSignIn": true,
            "associatedDomains": ["applinks:www.trycast.fr", "webcredentials:www.trycast.fr"],
            "config": {
                "usesNonExemptEncryption": false
            },
            "privacyManifests": {
                "NSPrivacyAccessedAPITypes": [
                    {
                        "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                        "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
                    },
                    {
                        "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                        "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
                    },
                    {
                        "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
                        "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
                    },
                    {
                        "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
                        "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
                    }
                ]
            }
        },
        "android": {
            "package": "com.cohozen.trycast",
            "adaptiveIcon": {
                "backgroundColor": "#14432a",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "www.trycast.fr",
                            "pathPrefix": "/rejoindre"
                        }
                    ],
                    "category": ["BROWSABLE", "DEFAULT"]
                }
            ]
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#faf8f4",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 96,
                    "dark": {
                        "backgroundColor": "#17140f"
                    }
                }
            ],
            "expo-secure-store",
            "expo-localization",
            "expo-notifications",
            [
                "expo-image-picker",
                {
                    "photosPermission": "TryCast acc\u00e8de \u00e0 tes photos pour d\u00e9finir ta photo de profil."
                }
            ],
            [
                "@sentry/react-native",
                {
                    "organization": "cohozen",
                    "project": "trycast"
                }
            ],
            [
                "@react-native-google-signin/google-signin",
                {
                    "iosUrlScheme": "com.googleusercontent.apps.261035883568-oqs9h5jb2njq0a9k1t421la93crse0if"
                }
            ],
            [
                "expo-build-properties",
                {
                    "ios": {
                        "extraPods": [
                            {
                                "name": "GoogleUtilities",
                                "modular_headers": true
                            },
                            {
                                "name": "RecaptchaInterop",
                                "modular_headers": true
                            }
                        ]
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "7dfc088c-9942-4873-97ba-4c2a048d3170"
            }
        },
        "owner": "cohozen"
    }
}
