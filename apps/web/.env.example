# Waitlist : projet Supabase visé par le formulaire (clé publishable uniquement).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=

# Liens d'invitation de ligue — variables de BUILD, à renseigner dans le projet
# Vercel plutôt qu'ici : elles ne servent qu'à générer web/public/.well-known/,
# qui autorise l'app à ouvrir https://www.trycast.fr/rejoindre/<CODE>.
# Absentes, rien n'est écrit et le site se construit quand même : les liens
# restent alors de simples pages web.

# Empreintes SHA-256 (pas SHA-1) des certificats de signature Android. Séparateur
# indifférent : virgule, espace ou retour à la ligne — on peut donc coller la
# copie brute de la Play Console. Play Console → Intégrité de
# l'application → Signature de l'application : y prendre la clé de signature
# actuelle, la précédente, et la clé d'importation. N'en déclarer qu'une fait
# échouer la vérification chez une partie seulement des testeurs.
# Une valeur mal formée arrête le build (message explicite).
ANDROID_CERT_FINGERPRINTS=

# Identifiant d'équipe Apple Developer (10 caractères). Indisponible tant
# qu'aucun abonnement n'est pris : sans lui, seul Android ouvre les liens.
APPLE_TEAM_ID=
