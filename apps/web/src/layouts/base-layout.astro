---
import '@fontsource/anton/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteFooter from '../components/site-footer.astro';
import SiteNav from '../components/site-nav.astro';
import {
    getDictionary,
    intlLocales,
    type Locale,
    locales,
    type RouteName,
    routes,
    toLocale,
} from '../i18n';

interface Props {
    title: string;
    description: string;
    /** Vignette d'aperçu, relative au site. Défaut : la vignette générique. */
    image?: string;
    /** Pages sans intérêt pour la recherche (atterrissages d'e-mail, invitations). */
    noindex?: boolean;
    /**
     * Page traduite : son nom dans la table des routes (src/i18n). Active le sélecteur
     * de langue et les balises hreflang vers ses équivalents.
     */
    route?: RouteName;
    /**
     * Atterrissage à URL unique, imposée par l'app ou les e-mails (/rejoindre/<code>,
     * /app/confirme…) : pas de /en/ possible, donc la page rend les deux langues dans des
     * blocs [data-locale] et le script du <head> choisit selon le navigateur (ou ?lang=),
     * avant le premier paint. Valeur : le <title> de chaque langue. Les balises d'aperçu
     * restent dans la langue du build — les robots n'exécutent pas de JS.
     */
    autoLocale?: Record<Locale, string>;
}

const {
    title,
    description,
    image = '/og-default.png',
    noindex = false,
    route,
    autoLocale,
} = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = getDictionary(locale);
const ogLocale = (l: keyof typeof intlLocales) => intlLocales[l].replace('-', '_');

// Absolues et non relatives : les robots d'aperçu (WhatsApp, iMessage,
// Discord, Slack) ignorent une og:image relative, sans le signaler.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// Les alternates prennent la même forme que la canonique (barre finale, comme le
// pathname du build) : Google veut que chaque hreflang pointe sur une URL canonique.
const alternate = (path: string) =>
    new URL(path.endsWith('/') ? path : `${path}/`, Astro.site).href;
const alternates =
    route && !noindex ? locales.map((l) => ({ locale: l, href: alternate(routes[route][l]) })) : [];
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {
            /* Une page d'atterrissage porte un identifiant dans son chemin
            (/rejoindre/<code>) que cette page statique ne connaît pas au build :
            annoncer une canonique ou une og:url la ramènerait au chemin nu, et
            un robot qui s'en sert pour la carte perdrait le code en route. */
            !noindex && (
                <>
                    <link rel="canonical" href={canonical.href} />
                    <meta property="og:url" content={canonical.href} />
                </>
            )
        }
        {noindex && <meta name="robots" content="noindex" />}
        {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
        {route && !noindex && <link rel="alternate" hreflang="x-default" href={alternate(routes[route].fr)} />}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={ogLocale(locale)} />
        {
            alternates
                .filter((a) => a.locale !== locale)
                .map((a) => <meta property="og:locale:alternate" content={ogLocale(a.locale)} />)
        }
        <meta property="og:site_name" content="TryCast" />
        <meta property="og:image" content={imageUrl.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t.meta.ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl.href} />
        <script is:inline>
            // Thème suivant la préférence système, avant le premier paint (tokens sur [data-theme]).
            (() => {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
                const apply = () => {
                    document.documentElement.dataset.theme = prefersDark.matches ? 'dark' : 'light';
                };
                apply();
                prefersDark.addEventListener('change', apply);
            })();
        </script>
        {
            autoLocale && (
                <script is:inline define:vars={{ titles: autoLocale }}>
                    // Même règle que l'app : anglais si le système l'est, français sinon
                    // (une langue non gérée retombe sur le français, comme i18next côté app).
                    // ?lang= force le choix : sélecteur de langue et recette.
                    (() => {
                        const forced = new URLSearchParams(window.location.search).get('lang');
                        const browser = (navigator.language || '').toLowerCase();
                        const lang =
                            forced === 'en' || forced === 'fr' ? forced : browser.startsWith('en') ? 'en' : 'fr';
                        document.documentElement.lang = lang;
                        document.title = titles[lang];
                    })();
                </script>
            )
        }
    </head>
    <body>
        {
            autoLocale ? (
                locales.map((l) => (
                    <div data-locale={l} lang={l}>
                        <SiteNav locale={l} autoLocale />
                    </div>
                ))
            ) : (
                <SiteNav route={route} />
            )
        }
        <slot />
        {
            autoLocale ? (
                locales.map((l) => (
                    <div data-locale={l} lang={l}>
                        <SiteFooter locale={l} />
                    </div>
                ))
            ) : (
                <SiteFooter />
            )
        }
    </body>
</html>
