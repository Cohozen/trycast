---
import { getDictionary, type Locale, localePath, type RouteName, toLocale } from '../i18n';
import BallLogo from './ball-logo.astro';
import LanguageSwitcher from './language-switcher.astro';

interface Props {
    /** Page traduite : affiche le sélecteur de langue vers son équivalent. */
    route?: RouteName;
    /** Langue du rendu, quand elle ne vient pas de l'URL (pages autoLocale). */
    locale?: Locale;
    /** Atterrissage à URL unique : sélecteur par ?lang= plutôt que par route. */
    autoLocale?: boolean;
}

const { route, autoLocale = false } = Astro.props;
const locale = Astro.props.locale ?? toLocale(Astro.currentLocale);
const t = getDictionary(locale);
const home = localePath('home', locale);
---

<header>
    <nav>
        <a href={`${home}#top`} class="brand">
            <BallLogo size={34} />
            <span class="wordmark">TryCast</span>
        </a>
        <div class="spacer"></div>
        <div class="links">
            <a href={`${home}#concept`}>{t.nav.concept}</a>
            <a href={`${home}#competitions`}>{t.nav.competitions}</a>
            <a href={`${home}#faq`}>{t.nav.faq}</a>
        </div>
        {(route || autoLocale) && <LanguageSwitcher route={route} locale={locale} />}
        <a href={`${home}#waitlist`} class="cta">{t.nav.waitlist}</a>
    </nav>
</header>

<style>
    header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 86%, transparent);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border);
    }

    nav {
        max-width: 1240px;
        margin: 0 auto;
        padding: 14px 24px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: var(--text);
    }

    .wordmark {
        font-family: var(--font-display);
        font-size: 25px;
        letter-spacing: 0.02em;
        line-height: 1;
    }

    .spacer {
        flex: 1;
    }

    .links {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    .links a {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 600;
    }

    .links a:hover {
        color: var(--text);
    }

    .cta {
        display: inline-flex;
        align-items: center;
        height: 42px;
        padding: 0 20px;
        border-radius: var(--radius-pill);
        background: var(--accent);
        color: var(--on-accent);
        font-size: 14px;
        font-weight: 700;
        box-shadow: var(--glow-accent);
        white-space: nowrap;
    }

    .cta:hover {
        background: var(--accent-press);
        color: var(--on-accent);
    }

    /* Sous 680 px, logo + sélecteur de langue + CTA doivent tenir sur 360 px (Android
       courant) : l'espaceur et ses deux gaps cèdent la place à une marge automatique. */
    @media (max-width: 680px) {
        nav {
            gap: 8px;
        }

        .links,
        .spacer {
            display: none;
        }

        .brand {
            margin-right: auto;
        }

        .cta {
            padding: 0 14px;
        }
    }
</style>
