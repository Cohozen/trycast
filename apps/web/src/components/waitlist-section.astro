---
import { getDictionary, toLocale } from '../i18n';

const t = getDictionary(toLocale(Astro.currentLocale)).waitlist;
---

<section id="waitlist">
    <div class="inner">
        <span class="overline"><span class="dot"></span>{t.overline}</span>
        <h2>{t.title.line1}<br />{t.title.line2}</h2>
        <p class="lede">{t.lede}</p>

        <div class="success" hidden>
            <div class="success-icon">
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M4 12.5l5 5 11-11"></path>
                </svg>
            </div>
            <div class="success-title">{t.successTitle}</div>
            <p>{t.successBody}</p>
        </div>

        <form novalidate>
            <div class="fields">
                <input
                    type="email"
                    name="email"
                    placeholder={t.placeholder}
                    aria-label={t.emailLabel}
                    autocomplete="email"
                    required
                />
                <label class="trap" aria-hidden="true">
                    {t.trap}
                    <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </label>
                <button type="submit">{t.submit}</button>
            </div>
            <div class="message">
                <span class="error error-email" hidden>{t.errorEmail}</span>
                <span class="error error-network" hidden>{t.errorNetwork}</span>
            </div>
            <p class="reassurance">{t.reassurance}</p>
        </form>
    </div>
</section>

<style>
    section {
        scroll-margin-top: 76px;
        background: var(--surface-sunken);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .inner {
        max-width: 720px;
        margin: 0 auto;
        padding: 96px 24px;
        text-align: center;
    }

    .overline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-faint);
    }

    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
    }

    h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(38px, 6.5vw, 76px);
        line-height: 0.92;
        margin: 20px 0 0;
        text-wrap: balance;
    }

    .lede {
        max-width: 460px;
        margin: 20px auto 0;
        font-size: 17px;
        line-height: 1.55;
        color: var(--text-muted);
        text-wrap: pretty;
    }

    /* ---- Carte succès ---- */
    .success {
        margin: 36px auto 0;
        max-width: 460px;
        padding: 28px 24px;
        border-radius: var(--radius-lg);
        background: var(--surface);
        border: 1.5px solid color-mix(in srgb, var(--success-500) 45%, var(--border));
        box-shadow: var(--shadow-md);
    }

    .success-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--success-500) 14%, transparent);
        color: var(--success-500);
        margin-bottom: 14px;
    }

    .success-title {
        font-family: var(--font-display);
        font-size: 26px;
    }

    .success p {
        margin: 8px 0 0;
        font-size: 15px;
        color: var(--text-muted);
    }

    /* ---- Formulaire ---- */
    form {
        margin: 36px auto 0;
        max-width: 500px;
    }

    .fields {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    input[type='email'] {
        flex: 1 1 240px;
        min-width: 0;
        height: 56px;
        padding: 0 20px;
        border-radius: var(--radius-pill);
        background: var(--surface);
        border: 1.5px solid var(--border-strong);
        font-family: var(--font-body);
        font-size: 16px;
        color: var(--text);
        outline: none;
    }

    input[type='email']::placeholder {
        color: var(--text-faint);
    }

    form.has-error input[type='email'] {
        border-color: var(--accent);
    }

    /* Honeypot : hors écran, invisible pour les humains, remplissable par les bots */
    .trap {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    button {
        flex: none;
        height: 56px;
        padding: 0 28px;
        border-radius: var(--radius-pill);
        background: var(--accent);
        color: var(--on-accent);
        border: none;
        font-family: var(--font-body);
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: var(--glow-accent);
    }

    button:hover {
        background: var(--accent-press);
    }

    button:disabled {
        opacity: 0.6;
        cursor: default;
    }

    .message {
        min-height: 22px;
        margin-top: 12px;
        text-align: left;
        padding-left: 20px;
    }

    .error {
        font-size: 13px;
        font-weight: 600;
        color: var(--accent);
    }

    .reassurance {
        margin: 4px 0 0;
        font-size: 13px;
        color: var(--text-faint);
    }
</style>

<script src="../scripts/waitlist.js"></script>

