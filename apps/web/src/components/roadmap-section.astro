---
import { getDictionary, toLocale } from '../i18n';
import SectionHeading from './section-heading.astro';

const t = getDictionary(toLocale(Astro.currentLocale)).roadmap;
---

<section id="competitions">
    <SectionHeading kicker={t.kicker} title={t.title} />
    <div class="grid">
        <div class="card">
            <div class="badge"><span class="badge-dot"></span>{t.launch.badge}</div>
            <div class="date">{t.launch.date}</div>
            <p>{t.launch.body}</p>
            <div class="chips">
                <span class="chip">{t.launch.sixNations}</span>
                <span class="chip">{t.launch.championsCup}</span>
            </div>
        </div>
        <div class="card card-highlight">
            <div class="badge"><span class="badge-dot"></span>{t.worldCup.badge}</div>
            <div class="date">{t.worldCup.date}</div>
            <p>{t.worldCup.body}</p>
            <div class="chips">
                <span class="chip chip-accent">{t.worldCup.chip}</span>
            </div>
        </div>
    </div>
</section>

<style>
    section {
        scroll-margin-top: 76px;
        max-width: 1240px;
        margin: 0 auto;
        padding: 88px 24px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 36px;
    }

    .card {
        padding: 32px 28px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        box-shadow: var(--shadow-sm);
    }

    .card-highlight {
        border: 1.5px solid color-mix(in srgb, var(--accent) 40%, var(--border));
        background: color-mix(in srgb, var(--accent) 5%, var(--surface));
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
    }

    .date {
        font-family: var(--font-display);
        font-size: 30px;
        margin: 12px 0 4px;
    }

    p {
        margin: 0 0 18px;
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.5;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .chip {
        display: inline-flex;
        height: 30px;
        align-items: center;
        padding: 0 12px;
        border-radius: 999px;
        border: 1.5px solid var(--border-strong);
        font-size: 12px;
        font-weight: 600;
    }

    .chip-accent {
        border: none;
        background: var(--accent);
        color: var(--on-accent);
        font-weight: 700;
    }
</style>
