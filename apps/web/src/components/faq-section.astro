---
import { getDictionary, toLocale } from '../i18n';
import SectionHeading from './section-heading.astro';

const t = getDictionary(toLocale(Astro.currentLocale)).faq;
const faqs = [t.items.free, t.items.money, t.items.when, t.items.competitions, t.items.friends];
---

<section id="faq">
    <SectionHeading kicker={t.kicker} title={t.title} />
    <div>
        {
            faqs.map((faq) => (
                <details>
                    <summary>
                        <span class="question">{faq.q}</span>
                        <span class="plus">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.4"
                                stroke-linecap="round">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </span>
                    </summary>
                    <p>{faq.a}</p>
                </details>
            ))
        }
    </div>
</section>

<style>
    section {
        scroll-margin-top: 76px;
        max-width: 900px;
        margin: 0 auto;
        padding: 0 24px 88px;
    }

    details {
        border-bottom: 1px solid var(--border);
    }

    summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 4px;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .question {
        flex: 1;
        font-size: clamp(17px, 2.4vw, 21px);
        font-weight: 700;
    }

    .plus {
        flex: none;
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        transition: transform var(--dur) var(--ease-out);
    }

    details[open] .plus {
        transform: rotate(45deg);
    }

    details p {
        margin: 0;
        padding: 0 44px 26px 4px;
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-muted);
        text-wrap: pretty;
    }
</style>
