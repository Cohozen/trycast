---
import '@fontsource/anton/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteFooter from '../components/site-footer.astro';
import SiteNav from '../components/site-nav.astro';

interface Props {
    title: string;
    description: string;
    /** Vignette d'aperçu, relative au site. Défaut : la vignette générique. */
    image?: string;
    /** Pages sans intérêt pour la recherche (atterrissages d'e-mail, invitations). */
    noindex?: boolean;
}

const { title, description, image = '/og-default.png', noindex = false } = Astro.props;

// Absolues et non relatives : les robots d'aperçu (WhatsApp, iMessage,
// Discord, Slack) ignorent une og:image relative, sans le signaler.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {
            /* Une page d'atterrissage porte un identifiant dans son chemin
            (/rejoindre/<code>) que cette page statique ne connaît pas au build :
            annoncer une canonique ou une og:url la ramènerait au chemin nu, et
            un robot qui s'en sert pour la carte perdrait le code en route. */
            !noindex && (
                <>
                    <link rel="canonical" href={canonical.href} />
                    <meta property="og:url" content={canonical.href} />
                </>
            )
        }
        {noindex && <meta name="robots" content="noindex" />}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="fr_FR" />
        <meta property="og:site_name" content="TryCast" />
        <meta property="og:image" content={imageUrl.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="TryCast — pronostics rugby entre amis" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl.href} />
        <script is:inline>
            // Thème suivant la préférence système, avant le premier paint (tokens sur [data-theme]).
            (() => {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
                const apply = () => {
                    document.documentElement.dataset.theme = prefersDark.matches ? 'dark' : 'light';
                };
                apply();
                prefersDark.addEventListener('change', apply);
            })();
        </script>
    </head>
    <body>
        <SiteNav />
        <slot />
        <SiteFooter />
    </body>
</html>
