---
// Lien vers la même page dans l'autre langue, lu dans la table des routes. Pas de
// redirection automatique selon le navigateur (décision du 2026-09-11) : le visiteur
// choisit, et les moteurs trouvent l'équivalent par les balises hreflang du layout.
import { getDictionary, localePath, otherLocale, type RouteName, toLocale } from '../i18n';

interface Props {
    route: RouteName;
}

const { route } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const target = otherLocale(locale);
const t = getDictionary(locale);
---

<a href={localePath(route, target)} hreflang={target} lang={target} title={t.switcher.title} aria-label={t.switcher.title}>
    {t.switcher.label}
</a>

<style>
    a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 42px;
        min-width: 42px;
        padding: 0 10px;
        border-radius: var(--radius-pill);
        border: 1.5px solid var(--border-strong);
        color: var(--text-muted);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.06em;
    }

    a:hover {
        border-color: var(--text);
        color: var(--text);
    }
</style>
